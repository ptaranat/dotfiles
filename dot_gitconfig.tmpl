{{- $signingkey := .signingkey | replace "~" .chezmoi.homeDir -}}
{{- $cansign := stat $signingkey -}}
[user]
	name = Panat Taranat
	email = {{ .email }}
	signingkey = {{ .signingkey }}
[credential]
{{- if eq .chezmoi.os "darwin" }}
	helper = /opt/homebrew/bin/gh auth git-credential
{{- else }}
	helper = !gh auth git-credential
{{- end }}

# Empty helper resets the list so osxkeychain cannot answer first.
[credential "https://github.com"]
	helper =
{{- if eq .chezmoi.os "darwin" }}
	helper = /opt/homebrew/bin/gh auth git-credential
{{- else }}
	helper = !gh auth git-credential
{{- end }}
[credential "https://gist.github.com"]
	helper =
{{- if eq .chezmoi.os "darwin" }}
	helper = /opt/homebrew/bin/gh auth git-credential
{{- else }}
	helper = !gh auth git-credential
{{- end }}
[alias]
	graphgpg = log --graph --color --pretty=format:"%C(yellow)%H%C(green)%d%C(reset)%n%x20%cd%n%x20%cn%C(blue)%x20(%ce)%x20%C(cyan)[gpg:%GK%x20%G?]%C(reset)%n%x20%s%n"
	graph = log --graph --color --pretty=format:"%C(yellow)%H%C(green)%d%C(reset)%n%x20%cd%n%x20%cn%C(blue)%x20(%ce)%x20%C(cyan)%C(reset)%n%x20%s%n"
	last = log -1 --stat
	cherry-pit = "!f() { git rebase -r --onto \"$1\"^ \"$1\"; }; f"
[color]
	ui = auto
[core]
	pager = delta
	excludesfile = ~/.gitignore_global
[delta]
	plus-style = "syntax #012800"
	minus-style = "syntax #340001"
	syntax-theme = OneHalfDark
	navigate = true
	side-by-side = true
[interactive]
	diffFilter = delta --color-only
[pull]
	ff = only
[push]
	default = current
	autoSetupRemote = true
[difftool]
	prompt = false

[difftool "vimdiff"]
	cmd = nvim -f -c \"Gdiffsplit!\" \"$MERGED\"
[gpg]
	format = ssh

[gpg "ssh"]
	allowedSignersFile = ~/.config/git/allowed_signers
# Sign only once the key exists, or every commit fails.
[commit]
	gpgsign = {{ if $cansign }}true{{ else }}false{{ end }}
[tag]
	gpgsign = {{ if $cansign }}true{{ else }}false{{ end }}
[init]
	defaultBranch = main
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
[rebase]
	autosquash = true
	autoStash = true
	updateRefs = true

[rerere]
	enabled = true
	autoUpdate = true

[branch]
	sort = -committerdate

[column]
	ui = auto

[fetch]
	prune = true
	pruneTags = true

[diff]
	algorithm = histogram
	renames = copies
	mnemonicPrefix = true
	tool = vimdiff
[merge]
	conflictstyle = zdiff3

{{- if and .work .workemail .workdir }}
# Trailing slash makes gitdir match every repo below it.
[includeIf "gitdir:{{ .workdir | trimSuffix "/" }}/"]
	path = ~/.config/git/work.gitconfig
{{- end }}

# Keep last: it must be able to override allowedSignersFile.
[include]
	path = ~/.gitconfig-local

[user]
	name = Panat Taranat
	email = panat@taranat.com
	# A public key path, not a GPG key id. Keep the tilde: a hardcoded
	# /home/panat would not resolve on the mac. Dedicated rather than id_rsa so
	# it can be rotated without touching anything that authenticates.
	signingkey = ~/.ssh/id_ed25519_signing.pub
[credential]
{{- if eq .chezmoi.os "darwin" }}
	helper = /opt/homebrew/bin/gh auth git-credential
{{- else }}
	# `!` shells out, so gh resolves on PATH rather than at a fixed prefix.
	helper = !gh auth git-credential
{{- end }}
[alias]
	graphgpg = log --graph --color --pretty=format:"%C(yellow)%H%C(green)%d%C(reset)%n%x20%cd%n%x20%cn%C(blue)%x20(%ce)%x20%C(cyan)[gpg:%GK%x20%G?]%C(reset)%n%x20%s%n"
	graph = log --graph --color --pretty=format:"%C(yellow)%H%C(green)%d%C(reset)%n%x20%cd%n%x20%cn%C(blue)%x20(%ce)%x20%C(cyan)%C(reset)%n%x20%s%n"
	last = log -1 --stat
	cherry-pit = "!f() { git rebase -r --onto \"$1\"^ \"$1\"; }; f"
	# Structural diff; see the [diff "difftastic"] section below.
	dft = "!DFT_DISPLAY=inline DFT_BACKGROUND=dark git -c diff.external=difft -c core.pager='less -RF' diff"
	dlog = "!DFT_DISPLAY=inline DFT_BACKGROUND=dark git -c diff.external=difft -c core.pager='less -RF' log -p --ext-diff"
	dshow = "!DFT_DISPLAY=inline DFT_BACKGROUND=dark git -c diff.external=difft -c core.pager='less -RF' show --ext-diff"
[color]
	ui = auto
[core]
	pager = delta
[delta]
	plus-style = "syntax #012800"
	minus-style = "syntax #340001"
	syntax-theme = OneHalfDark
	navigate = true
	side-by-side = true
[interactive]
	diffFilter = delta --color-only
[pull]
	ff = only
[push]
	default = current
	autoSetupRemote = true
# difftastic diffs the syntax tree, so reformatting and moved code stop reading
# as churn. Opt-in only: delta is better for review and this is not an applyable
# patch. The defaults are why it reads as unreadable, hence: inline (the split
# view wraps at normal widths), dark (its only palette knob), and plain less
# (it emits its own ANSI, which delta cannot parse).
[diff "difftastic"]
	command = difft
[difftool "difftastic"]
	cmd = difft "$LOCAL" "$REMOTE"
[difftool]
	prompt = false

[difftool "vimdiff"]
	cmd = nvim -f -c \"Gdiffsplit!\" \"$MERGED\"
[gpg]
	# The [gpg] name and gpgsign keys are historical; with format = ssh this
	# means SSH-signed.
	format = ssh

[gpg "ssh"]
	# Without this `git log --show-signature` reports "No principal matched"
	# even for signatures git just made.
	allowedSignersFile = ~/.config/git/allowed_signers
[commit]
	gpgsign = true
[tag]
	gpgsign = true
[init]
	defaultBranch = main
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
[rebase]
	autosquash = true
	# Stash and restore a dirty worktree around a rebase instead of refusing.
	autoStash = true
	# Move stacked branches too, instead of stranding them on pre-rebase commits.
	updateRefs = true

[rerere]
	# Replay recorded conflict resolutions, which recur constantly in a rebase.
	enabled = true
	autoUpdate = true

[branch]
	# `git branch` sorted by most recent commit rather than alphabetically.
	sort = -committerdate

[column]
	# Multi-column listings when the terminal is wide enough.
	ui = auto

[fetch]
	# Delete local refs for branches deleted on the remote.
	prune = true
	pruneTags = true

[diff]
	# More readable than Myers when a block moves or braces shift.
	algorithm = histogram
	# Detect renames and copies.
	renames = copies
	# Nicer prefixes than a/ and b/ in the header.
	mnemonicPrefix = true
	tool = vimdiff
[merge]
	# diff3 without the lines both sides agree on. Needs git >= 2.35.
	conflictstyle = zdiff3

# Machine-local overrides; git skips an include it cannot read. Last in the
# file on purpose, since git takes the last value it sees and this has to be
# able to override allowedSignersFile. The work identity lives here so no
# employer name lands in this public repo.
[include]
	path = ~/.gitconfig-local

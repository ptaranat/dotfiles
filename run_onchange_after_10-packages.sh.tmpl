#!/bin/sh
# Install everything in the Brewfile. First of the numbered scripts, so tools
# exist before anything uses them (30-completions needs pnpm). The hash below
# is what makes run_onchange_ work: chezmoi re-runs on rendered-content change,
# and this script's text rarely changes, so without it edits do nothing.
#
# Brewfile hash: {{ include "Brewfile" | sha256sum }}

set -eu

[ "$(uname -s)" = "Darwin" ] || exit 0
command -v brew >/dev/null 2>&1 || {
	echo "==> brew not installed; skipping package install"
	exit 0
}

BREWFILE="{{ .chezmoi.sourceDir }}/Brewfile"
[ -f "$BREWFILE" ] || exit 0

echo "==> installing packages from Brewfile"

# --no-upgrade is deliberate. `brew bundle` installs *and upgrades* by default,
# which is how a routine apply replaced tmux under a running server: sessions
# stayed listable but unattachable, and `brew cleanup` removed the old binary.
# Upgrade by hand, having checked what is running:
#     brew bundle --file="$(chezmoi source-path)/Brewfile"
brew bundle --file="$BREWFILE" --no-upgrade

echo "==> packages up to date (nothing upgraded; run brew bundle by hand for that)"

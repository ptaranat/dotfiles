#!/bin/sh
# Install everything in the Brewfile. Runs before the other numbered scripts so
# tools exist before anything uses them (30-completions needs pnpm).
#
# The hash is what makes run_onchange_ fire: chezmoi re-runs on rendered-content
# change, and this script itself rarely changes.
#
# Brewfile hash: {{ include "Brewfile" | sha256sum }}

set -eu

[ "$(uname -s)" = "Darwin" ] || exit 0
command -v brew >/dev/null 2>&1 || {
	echo "==> brew not installed; skipping package install"
	exit 0
}

BREWFILE="{{ .chezmoi.sourceDir }}/Brewfile"
[ -f "$BREWFILE" ] || exit 0

echo "==> installing packages from Brewfile"

# --no-upgrade: `brew bundle` upgrades by default, which once replaced the tmux
# binary under a running server. Upgrade by hand when nothing is mid-flight:
#     brew bundle --file="$(chezmoi source-path)/Brewfile"
brew bundle --file="$BREWFILE" --no-upgrade

echo "==> packages up to date (nothing upgraded; run brew bundle by hand for that)"

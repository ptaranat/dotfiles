# The only zsh file that lives in $HOME. Everything else sits under
# $XDG_CONFIG_HOME/zsh, which this points zsh at.
#
# .zshenv is sourced for every zsh invocation (interactive or not), so keep it
# to environment setup only: no output, no prompts, nothing slow.

export XDG_CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
export XDG_CACHE_HOME="${XDG_CACHE_HOME:-$HOME/.cache}"
export XDG_DATA_HOME="${XDG_DATA_HOME:-$HOME/.local/share}"
export XDG_STATE_HOME="${XDG_STATE_HOME:-$HOME/.local/state}"

export ZDOTDIR="$XDG_CONFIG_HOME/zsh"

# History is configured in .zshrc, not here. macOS ships an /etc/zshrc that
# hardcodes HISTFILE, HISTSIZE and SAVEHIST, and zsh sources it for every
# interactive shell after this file, so anything set here would be clobbered.

# Set here, not in .zshrc, so tools in ~/.local/bin resolve in non-interactive
# shells too (scripts, ssh commands, editor subprocesses).
path=($HOME/.local/bin(N-/) $path)

# `go install` writes to $GOPATH/bin (~/go/bin) by default, and that directory
# has never been on PATH here -- go comes from Homebrew rather than mise, so
# nothing ever added it. Eight binaries (dlv, golangci-lint, buf, ...) had
# accumulated there unreachable. Pointing GOBIN at ~/.local/bin, prepended just
# above, means an ad-hoc `go install` lands somewhere that resolves in both
# interactive and non-interactive shells.
#
# Long-lived Go tools still belong in mise's go backend instead, declared in
# ~/.config/mise/config.toml, so they are versioned and reproducible. GOBIN is
# for the one-off case.
export GOBIN="$HOME/.local/bin"

# `bun install -g` writes bin shims to $BUN_INSTALL/bin, defaulting to ~/.bun.
# That directory was on no PATH here, so omp and dw sat unreachable in exactly
# the way $GOPATH/bin did above. bun itself now comes from mise; ~/.bun keeps
# only the global packages, which is why this is a plain path entry and not a
# runtime prepend. Left at the default location rather than moved under
# $XDG_DATA_HOME: BUN_INSTALL would then have to be set for every context that
# ever runs bun, and anything missing it would silently rebuild ~/.bun and
# split the globals across two directories.
path=($path $HOME/.bun/bin(N-/))

# Homebrew goes here rather than in rc.d/01-environment.zsh, and the ordering
# is the whole point. rc.d is sourced at the *end* of .zshrc, well after
# `mise activate`, so a prepend there lands in front of mise and shadows every
# runtime mise is supposed to own. On the WSL box that meant linuxbrew's node
# beating mise's, silently, with `mise ls` reporting tools as missing.
#
# .zshenv runs before .zshrc entirely, so mise prepends after this and wins.
{{ if eq .chezmoi.os "darwin" -}}
path=(/opt/homebrew/bin(N-/) $path)
{{- else -}}
path=(/home/linuxbrew/.linuxbrew/bin(N-/) $path)
{{- end }}

# rustup's installer appends `. "$HOME/.cargo/env"` to this file, which sources
# a shell script on every zsh invocation to do one path prepend. Written out
# here instead, in the same form as every other entry above, so reinstalling
# rustup cannot reintroduce a line chezmoi would then report as drift.
#
# This does not outrank Homebrew despite sitting after the prepend above:
# /etc/profile.d/brew.sh re-prepends linuxbrew for every login shell, well
# after .zshenv, so brew lands ahead of this. Harmless today because rustup is
# the only rustc and cargo on this box; the Brewfile's `brew "rust"` is a
# leftover that was never installed. Installing it would shadow rustup, and the
# fix then is to drop it from the Brewfile, not to reorder here.
path=($HOME/.cargo/bin(N-/) $path)

# Sourced by every zsh, interactive or not: no output, nothing slow.

export XDG_CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
export XDG_CACHE_HOME="${XDG_CACHE_HOME:-$HOME/.cache}"
export XDG_DATA_HOME="${XDG_DATA_HOME:-$HOME/.local/share}"
export XDG_STATE_HOME="${XDG_STATE_HOME:-$HOME/.local/state}"

export ZDOTDIR="$XDG_CONFIG_HOME/zsh"

# PATH lives here for non-interactive shells. (N-/) skips missing dirs.
path=($HOME/.local/bin(N-/) $path)

# GOPATH/bin is not on PATH, so land go installs in ~/.local/bin.
export GOBIN="$HOME/.local/bin"

# Keep the default ~/.bun: moving it needs BUN_INSTALL everywhere.
path=($path $HOME/.bun/bin(N-/))

# Must stay in .zshenv so mise (activated in .zshrc) prepends after.
{{ if eq .chezmoi.os "darwin" -}}
path=(/opt/homebrew/bin(N-/) /opt/homebrew/sbin(N-/) $path)
{{- else -}}
path=(/home/linuxbrew/.linuxbrew/bin(N-/) /home/linuxbrew/.linuxbrew/sbin(N-/) $path)
{{- end }}

# Inlined from ~/.cargo/env so a rustup reinstall causes no drift.
path=($HOME/.cargo/bin(N-/) $path)

path=($HOME/bin(N-/) $path)
path=($HOME/.opencode/bin(N-/) $path)

path=($path $HOME/.orbstack/bin(N-/))
path=($path "$HOME/Library/Application Support/JetBrains/Toolbox/scripts"(N-/))

fpath+=($HOME/.orbstack/shell/completions/zsh(N-/))

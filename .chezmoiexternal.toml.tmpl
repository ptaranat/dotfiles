{{ if and .work (stat (.signingkey | replace "~" .chezmoi.homeDir)) -}}
# Gated on the signing key: a failed clone aborts the whole apply.
[".config/zsh/work"]
    type = "git-repo"
    url = "git@github.com:ptaranat/work.git"
    refreshPeriod = "168h"
{{ end -}}

{{ if eq .chezmoi.os "darwin" -}}
# Gated here: .chezmoiignore does not stop externals.
[".config/ghostty/shaders"]
    type = "git-repo"
    url = "https://github.com/sahaj-b/ghostty-cursor-shaders.git"
    refreshPeriod = "720h"
{{ end -}}

[".local/share/znap/zsh-snap"]
    type = "git-repo"
    url = "https://github.com/marlonrichert/zsh-snap.git"
    refreshPeriod = "168h"

# Plugins still need tpm/bin/install_plugins once per machine.
[".tmux/plugins/tpm"]
    type = "git-repo"
    url = "https://github.com/tmux-plugins/tpm.git"
    refreshPeriod = "168h"

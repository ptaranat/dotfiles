# Repos chezmoi clones and keeps updated, replacing git submodules: no pinned
# SHA to commit, no --recurse-submodules, refreshed on their own schedule.

# Private work config. .zshrc globs $ZDOTDIR/work/*.zsh after rc.d so it can
# override; a machine without access to the repo just skips it.
[".config/zsh/work"]
    type = "git-repo"
    url = "git@github.com:ptaranat/work.git"
    refreshPeriod = "168h"

{{ if eq .chezmoi.os "darwin" -}}
# Ghostty cursor shaders. Gated here, not in .chezmoiignore: externals are
# fetched regardless of what that file lists, and `chezmoi ignored` printing
# the path is not evidence it will be skipped. On WSL this cloned 288K of
# shaders for a terminal that is not installed.
[".config/ghostty/shaders"]
    type = "git-repo"
    url = "https://github.com/sahaj-b/ghostty-cursor-shaders.git"
    refreshPeriod = "720h"
{{ end -}}

# znap, the zsh plugin manager. .zshrc sources znap.zsh from here, so without
# it a fresh machine gets no plugins and no prompt. Previously cloned by hand.
[".local/share/znap/zsh-snap"]
    type = "git-repo"
    url = "https://github.com/marlonrichert/zsh-snap.git"
    refreshPeriod = "168h"

# tpm, the tmux plugin manager. .tmux.conf's trailing `run` fails silently
# without it: tmux starts, every plugin is skipped, the status bar goes stock.
# The plugins themselves still need `tpm/bin/install_plugins` once per machine.
[".tmux/plugins/tpm"]
    type = "git-repo"
    url = "https://github.com/tmux-plugins/tpm.git"
    refreshPeriod = "168h"

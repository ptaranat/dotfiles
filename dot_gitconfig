[user]
	name = Panat Taranat
	email = panat.taranat@gmail.com
	# A path to a public key, not a GPG key id; see [gpg] format = ssh below.
	signingkey = ~/.ssh/id_rsa.pub
[credential]
	helper = /opt/homebrew/bin/gh auth git-credential
[alias]
	graphgpg = log --graph --color --pretty=format:"%C(yellow)%H%C(green)%d%C(reset)%n%x20%cd%n%x20%cn%C(blue)%x20(%ce)%x20%C(cyan)[gpg:%GK%x20%G?]%C(reset)%n%x20%s%n"
	graph = log --graph --color --pretty=format:"%C(yellow)%H%C(green)%d%C(reset)%n%x20%cd%n%x20%cn%C(blue)%x20(%ce)%x20%C(cyan)%C(reset)%n%x20%s%n"
	last = log -1 --stat
	cherry-pit = "!f() { git rebase -r --onto \"$1\"^ \"$1\"; }; f"
	# Structural diff; see [diff "difftastic"] for why the env vars are set.
	dft = "!DFT_DISPLAY=inline DFT_BACKGROUND=dark git -c diff.external=difft -c core.pager='less -RF' diff"
	dlog = "!DFT_DISPLAY=inline DFT_BACKGROUND=dark git -c diff.external=difft -c core.pager='less -RF' log -p --ext-diff"
	dshow = "!DFT_DISPLAY=inline DFT_BACKGROUND=dark git -c diff.external=difft -c core.pager='less -RF' show --ext-diff"
[color]
	ui = auto
[core]
	pager = delta
[delta]
	plus-style = "syntax #012800"
	minus-style = "syntax #340001"
	syntax-theme = OneHalfDark
	navigate = true
	side-by-side = true
[interactive]
	diffFilter = delta --color-only
[pull]
	ff = only
[push]
	default = current
	autoSetupRemote = true
# difftastic diffs the syntax tree, so reformatting stops reading as churn.
# Opt-in per command: delta stays better for review, and difftastic output is not
# an applyable patch. The alias env vars above are needed because the defaults
# wrap badly (DFT_DISPLAY=inline), pick the dim palette (DFT_BACKGROUND=dark),
# and emit ANSI that delta cannot parse (core.pager=less -RF).
[diff "difftastic"]
	command = difft
[difftool "difftastic"]
	cmd = difft "$LOCAL" "$REMOTE"
[difftool]
	prompt = false

[difftool "vimdiff"]
	cmd = nvim -f -c \"Gdiffsplit!\" \"$MERGED\"
[gpg]
	# "gpgsign = true" with format = ssh means SSH-signed; git kept the old
	# section and setting names when it added other signing formats.
	format = ssh

[gpg "ssh"]
	# Without this, `git log --show-signature` reports "No principal matched"
	# even for signatures git just created.
	allowedSignersFile = ~/.config/git/allowed_signers
[commit]
	gpgsign = true
[tag]
	gpgsign = true
[init]
	defaultBranch = main
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
[rebase]
	autosquash = true
	# Stash and restore a dirty worktree instead of refusing to rebase.
	autoStash = true
	# Move stacked branches too, so they do not silently point at pre-rebase commits.
	updateRefs = true

[rerere]
	# Replay conflict resolutions, which recur constantly during a long rebase.
	enabled = true
	autoUpdate = true

[branch]
	sort = -committerdate

[column]
	ui = auto

[fetch]
	prune = true
	pruneTags = true

[diff]
	# More readable than Myers when a block moves or braces shift.
	algorithm = histogram
	renames = copies
	mnemonicPrefix = true
	tool = vimdiff
[merge]
	# diff3 without the lines both sides agree on. Requires git >= 2.35.
	conflictstyle = zdiff3
# Written by `gh auth login`. The empty `helper =` resets the inherited list so
# gh's helper is the only one for these hosts; gh rewrites this if removed.
[credential "https://github.com"]
	helper =
	helper = !/opt/homebrew/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper =
	helper = !/opt/homebrew/bin/gh auth git-credential

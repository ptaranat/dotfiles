{{- /* Asked once on first `chezmoi init` and remembered in the generated config,
       so identity never lands in this public repo. Re-ask with `chezmoi init --prompt`. */ -}}
{{- $work := promptBoolOnce . "work" "Is this a work machine" -}}
{{- $email := promptStringOnce . "email" "Git commit email" -}}
{{- $signingkey := promptStringOnce . "signingkey" "SSH signing public key" "~/.ssh/id_ed25519_signing.pub" -}}
{{- /* Work repos commit as the work address. Both answers stay out of the repo
       for the same reason as email: they name the employer. */ -}}
{{- $workemail := "" -}}
{{- $workdir := "" -}}
{{- if $work -}}
{{-   $workemail = promptStringOnce . "workemail" "Work commit email (used under the work directory)" -}}
{{-   $workdir = promptStringOnce . "workdir" "Work directory" "~/projects/work" -}}
{{- end -}}
# chezmoi's own config, regenerated by `chezmoi init` from this template.
#
# sourceDir has to be here. It is what tells chezmoi where the source lives,
# and without it `chezmoi init` writes a config that falls back to the default
# ~/.local/share/chezmoi, which does not exist on either machine: chezmoi then
# has no source tree at all until the line is put back by hand.
sourceDir = {{ .chezmoi.sourceDir | quote }}

# Pinned rather than inherited from the login umask: pam gives this box 002, so
# chezmoi computed 775/664 against deployed copies written at 755/644, showing
# up as 47 "modified" entries whose diffs were mode lines and nothing else.
umask = 0o022

[data]
    work = {{ $work }}
    email = {{ $email | quote }}
    signingkey = {{ $signingkey | quote }}
    workemail = {{ $workemail | quote }}
    workdir = {{ $workdir | quote }}

# Committing and pushing the source repo stays a deliberate act, not something
# an apply does on your behalf.
[git]
    autoCommit = false
    autoPush = false

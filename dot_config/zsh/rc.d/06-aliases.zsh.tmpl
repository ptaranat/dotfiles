# attach/create a tmux session by name, or fzf-pick one; bare tm on an empty server -> main
#
# When `tm` starts the server, resurrect finishes by switching to whatever
# session was active at save time, yanking you out of the one you asked for.
# @tm-target tells the post-restore hook in ~/.tmux.conf to switch back, and is
# set only when this call started the server.
tm() {
  local change target="$1" server_was_up=1
  [[ -n "$(tmux list-sessions 2>/dev/null)" ]] || server_was_up=0
  [[ -n "$TMUX" ]] && change=switch-client || change=attach-session
  if [[ -z "$target" ]]; then
    if (( server_was_up )); then
      target=$(tmux list-sessions -F '#{session_name}' | fzf --exit-0) || return  # esc cancels
      [[ -z "$target" ]] && return
    else
      target=main
    fi
  fi
  tmux "$change" -t "$target" 2>/dev/null || {
    tmux new-session -d -s "$target" || return
    (( server_was_up )) || tmux set-option -g @tm-target "$target"
    tmux "$change" -t "$target"
  }
}


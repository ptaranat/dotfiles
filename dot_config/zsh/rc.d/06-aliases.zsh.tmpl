# Refuses templates: chezmoi add would flatten their conditionals.
cmadd() {
	local f src rc=0
	(( $# )) || { print -u2 "cmadd: need a path"; return 1 }
	for f in "$@"; do
		if ! src=$(chezmoi source-path "$f" 2>/dev/null); then
			print -u2 "cmadd: not managed by chezmoi: $f"
			rc=1
		elif [[ "$src" == *.tmpl ]]; then
			print -u2 "cmadd: $f is a template, adding it would flatten its conditionals."
			print -u2 "       hand-merge instead: \$EDITOR $src"
			rc=1
		fi
	done
	(( rc )) && return $rc
	chezmoi add "$@"
}

if command -v chezmoi >/dev/null 2>&1; then
	() {
		local drift
		drift=$(chezmoi status 2>/dev/null) || return
		[[ -n "$drift" ]] || return
		print -u2 "chezmoi: deployed files differ from source, apply would revert them:"
		print -u2 "$drift"
		print -u2 "  keep the deployed version: cmadd <path>"
		print -u2 "  discard it:                chezmoi apply <path>"
	}
fi


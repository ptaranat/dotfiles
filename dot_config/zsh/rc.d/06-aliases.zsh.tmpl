# Pull a change made directly to a deployed file back into the source.
#
# A function, not plain `chezmoi add`: add regenerates the source from the
# *rendered* target, so on a template it silently discards every branch for the
# other OS. Nine managed files are templates, so this is the common case.
cmadd() {
	local f src rc=0
	(( $# )) || { print -u2 "cmadd: need a path"; return 1 }
	for f in "$@"; do
		if ! src=$(chezmoi source-path "$f" 2>/dev/null); then
			print -u2 "cmadd: not managed by chezmoi: $f"
			rc=1
		elif [[ "$src" == *.tmpl ]]; then
			print -u2 "cmadd: $f is a template, adding it would flatten its conditionals."
			print -u2 "       hand-merge instead: \$EDITOR $src"
			rc=1
		fi
	done
	(( rc )) && return $rc
	chezmoi add "$@"
}

# Warn when a deployed file was edited in place; the next apply reverts those,
# silently under --force. ~30ms across the tree, on every interactive shell.
if command -v chezmoi >/dev/null 2>&1; then
	() {
		local drift
		drift=$(chezmoi status 2>/dev/null) || return
		[[ -n "$drift" ]] || return
		print -u2 "chezmoi: deployed files differ from source, apply would revert them:"
		print -u2 "$drift"
		print -u2 "  keep the deployed version: cmadd <path>"
		print -u2 "  discard it:                chezmoi apply <path>"
	}
fi


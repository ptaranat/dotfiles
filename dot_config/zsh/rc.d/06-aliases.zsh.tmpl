# Fuzzy-pick any managed file. The named aliases above cover only what was
# worth naming, which is how completion.lua and editor.lua drifted. Assigned to
# a variable rather than piped, so cancelling fzf short-circuits the `&&`.
alias cmf='_cmsel=$(chezmoi managed --path-style=absolute --include=files | fzf --preview "chezmoi cat {}" --preview-window "right:60%") && chezmoi edit --apply "$_cmsel"; unset _cmsel'
alias nvimconf='_cmsel=$(chezmoi managed --path-style=absolute --include=files | rg "/nvim/" | fzf --preview "chezmoi cat {}" --preview-window "right:60%") && chezmoi edit --apply "$_cmsel"; unset _cmsel'


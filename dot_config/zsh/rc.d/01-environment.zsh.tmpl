# Put PATH entries in .zshenv: this runs after mise activate.

export EDITOR='nvim'
export VISUAL=$EDITOR

# Fixed socket so one agent serves every shell.
export SSH_AUTH_SOCK="$HOME/.ssh/agent.sock"

# No graphical askpass here; avoids exec(ssh-askpass) errors.
export SSH_ASKPASS_REQUIRE=never

ssh-add -l > /dev/null 2>&1
agent_state=$?

if (( agent_state == 2 )); then
	# 2: agent unreachable (socket absent or stale).
	rm -f "$SSH_AUTH_SOCK"
	mkdir -p -m 700 "${SSH_AUTH_SOCK:h}"
	ssh-agent -a "$SSH_AUTH_SOCK" > /dev/null
fi

# 1: agent has no identities.
# Eager: signing ignores AddKeysToAgent. Passphraseless on purpose.
if (( agent_state != 0 )) && [[ -f ~/.ssh/id_ed25519_signing ]]; then
	ssh-add -q ~/.ssh/id_ed25519_signing
fi
unset agent_state

# Without --mouse, less (and delta) ignores the scroll wheel.
export LESS='--mouse --wheel-lines=3 -RF'

export BAT_THEME=base16

export LANG=en_US.UTF-8

export FZF_DEFAULT_COMMAND="rg --files --no-ignore --hidden --follow -g '!{.git,node_modules}/*' 2> /dev/null"
export FZF_CTRL_T_COMMAND="$FZF_DEFAULT_COMMAND"

export FZF_CTRL_T_OPTS="--preview 'bat --style=numbers --color=always --line-range=:200 {} 2>/dev/null || eza -1 --color=always --icons --group-directories-first {} 2>/dev/null' --preview-window 'right:55%:wrap'"
export FZF_ALT_C_OPTS="--preview 'eza -1 --color=always --icons --group-directories-first {} 2>/dev/null | head -50'"

export AWS_SDK_LOAD_CONFIG=1
{{ $flavor := includeTemplate "flavor" . | trim -}}
{{ if eq $flavor "wsl" }}
# wslview only: naming a browser makes links open twice.
export BROWSER=wslview

# WSL sets this only for wsl.exe shells. ssh and mosh logins get none, and
# moshi-hook then puts its socket in /tmp where local agents never look.
[[ -z $XDG_RUNTIME_DIR && -d /wslg/runtime-dir ]] && export XDG_RUNTIME_DIR=/wslg/runtime-dir

# No systemd for moshi-hook's user unit; flock keeps it to one daemon.
if (( $+commands[moshi-hook] )) && ! pgrep -xu $USER moshi-hook >/dev/null; then
	setsid -f flock -n "$XDG_STATE_HOME/moshi/serve.lock" moshi-hook serve >/dev/null 2>&1
fi
# Same for macrod, the Macro agent runtime. `macrod service` exits when stdin
# reaches EOF, so sleep holds it open.
if (( $+commands[macrod] )) && [[ -f ~/.macrod/macrod.toml ]] && ! pgrep -xu $USER macrod >/dev/null; then
        setsid -f flock -n ~/.macrod/service.lock sh -c 'sleep infinity | exec macrod service --config ~/.macrod/macrod.toml >>~/.macrod/macrod.log 2>&1' >/dev/null 2>&1
fi
{{ end }}
{{ if ne $flavor "darwin" }}
export AWS_VAULT_BACKEND=pass
{{ end }}

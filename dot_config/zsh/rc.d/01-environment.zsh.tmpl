# Paths. The (N-/) qualifier keeps an entry only when it is an existing
# directory, so anything uninstalled or moved drops out silently instead of
# accumulating in $PATH and being searched on every command.
# ~/.local/bin and Homebrew are added in .zshenv so non-interactive shells get
# them too, and so that `mise activate` in .zshrc lands in front of Homebrew
# rather than behind it. Do not move the Homebrew prepend back here: this file
# is sourced after mise activates, so it would shadow every mise-managed
# runtime that also exists in Homebrew.
path=($HOME/bin(N-/) $path)

# nvim everywhere. This used to fall back to vim over SSH, from when the config
# was vimscript and worked in both; it is Lua now and vim cannot read it, so
# the fallback would have meant an unconfigured editor rather than a familiar
# one.
export EDITOR='nvim'
export VISUAL=$EDITOR

# One agent per machine, reached over a fixed socket. Keying off an unset
# SSH_AUTH_SOCK instead meant a fresh agent per login shell: a key unlocked in
# one terminal was invisible in the next, and the orphans accumulated all day.
export SSH_AUTH_SOCK="$HOME/.ssh/agent.sock"

# ssh reaches for a graphical ssh-askpass whenever it needs a passphrase and
# has no terminal to ask on. Nothing on this box provides one, so that path
# only ever produces "exec(ssh-askpass): No such file or directory". Declining
# it turns that into a plain "no passphrase given".
export SSH_ASKPASS_REQUIRE=never

ssh-add -l > /dev/null 2>&1
agent_state=$?

if (( agent_state == 2 )); then
	# 2 is "could not open a connection", so the socket is either absent or
	# left over from a previous boot with nothing behind it.
	rm -f "$SSH_AUTH_SOCK"
	ssh-agent -a "$SSH_AUTH_SOCK" > /dev/null
fi

# 1 is "agent has no identities", and it is reachable without going through the
# branch above: ssh-add -D, or an agent left running by a shell that died
# before it added anything. Loading only on agent creation meant every shell
# after that one saw a live socket, skipped the add, and left signing broken
# for the rest of the boot -- so this is checked on its own.
#
# Loaded eagerly because ssh-keygen does not read AddKeysToAgent from
# ssh_config when it signs a commit. The signing key deliberately carries no
# passphrase: while the agent holds it, anything running as this user can sign
# through the socket without knowing one, so encrypting it only guarded against
# the file being stolen for offline use, and that cost a prompt on every WSL
# restart. A forged signature is revocable by pulling the key from GitHub's
# allowed signers; id_rsa grants push access, so it stays encrypted and is left
# out here. ssh honours AddKeysToAgent for it, so it loads on first use and
# prompts once per boot, only on boots with a push.
#
# -q because ssh-add announces "Identity added:" on stderr on success, which
# lands in the first shell of every boot with nothing to do about it.
if (( agent_state != 0 )) && [[ -f ~/.ssh/id_ed25519_signing ]]; then
	ssh-add -q ~/.ssh/id_ed25519_signing
fi
unset agent_state

# Pager. Mouse wheel scrolling has to be asked for: without --mouse, less
# ignores the wheel entirely and no pager built on it scrolls -- which includes
# delta, since it shells out to less. An earlier version of this file carried
# this line commented out, which is why scrolling silently did not work.
#
# -R passes through colour escapes but nothing else; plain -r forwards every
# control character, which can corrupt the display on binary input.
# -F skips the pager when the output already fits on one screen.
export LESS='--mouse --wheel-lines=3 -RF'

# Bat theme
export BAT_THEME=base16

# Language
export LANG=en_US.UTF-8

# fzf + rg
export FZF_DEFAULT_COMMAND="rg --files --no-ignore --hidden --follow -g '!{.git,node_modules}/*' 2> /dev/null"
export FZF_CTRL_T_COMMAND="$FZF_DEFAULT_COMMAND"

# Ctrl-T previews. The old setup got these from unixorn/fzf-zsh-plugin, which
# .zshrc dropped in favour of `source <(fzf --zsh)`. That binds the widgets but
# ships no options, so Ctrl-T came back as a bare list with no preview pane.
#
# --line-range keeps bat from rendering a whole large file for a preview that
# only shows the first screenful anyway.
export FZF_CTRL_T_OPTS="--preview 'bat --style=numbers --color=always --line-range=:200 {} 2>/dev/null || eza -1 --color=always --icons --group-directories-first {} 2>/dev/null' --preview-window 'right:55%:wrap'"
export FZF_ALT_C_OPTS="--preview 'eza -1 --color=always --icons --group-directories-first {} 2>/dev/null | head -50'"

# Node, Python and friends are managed by mise, activated in .zshrc. It
# replaced fnm here and pyenv before that. uv is kept for Python packaging:
# mise handles interpreter versions, uv handles dependencies and venvs, and
# mise will use uv to build venvs when it finds it.
export AWS_SDK_LOAD_CONFIG=1
{{ if ne .chezmoi.os "darwin" }}
# --- WSL ---------------------------------------------------------------------
# The non-darwin machine is WSL, so these are gated on os rather than on a
# kernel probe. If a plain Linux box ever joins, tighten this to check
# .chezmoi.kernel.osrelease for "microsoft".
#
# wslview hands the URL to Windows, which opens whatever is set as the default
# browser there. Naming a browser here instead gives two handlers that disagree:
# wslu's xdg-open goes to the Windows default while $BROWSER went to Chrome, so
# anything that tries $BROWSER and then falls back to xdg-open opened both.
#
# The comment that used to sit here said xdg-open would fail for want of a Linux
# browser. It does not. wslu provides /usr/local/bin/xdg-open and it works.
#
# Claude Code reads $BROWSER too, and opens URLs itself on top of whatever the
# terminal does with the same link, so a working value here means every link
# opens in two tabs. It gets BROWSER=/bin/true via the env block in
# ~/.claude/settings.json, which is outside this repo.
export BROWSER=wslview

# aws-vault reads credentials from pass, which is gpg-backed. Set here so the
# backend is explicit rather than depending on aws-vault's autodetection.
export AWS_VAULT_BACKEND=pass
{{ end }}

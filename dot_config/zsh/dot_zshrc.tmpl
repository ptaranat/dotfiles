# p10k instant prompt: must stay first, nothing above may print.
if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
	source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi

# Replaces omz's gpg-agent plugin (~730ms of startup).
export GPG_TTY=$TTY

# Not in .zshenv: macOS /etc/zshrc overrides it.
export HISTFILE="${XDG_STATE_HOME:-$HOME/.local/state}/zsh/history"
export HISTSIZE=50000
export SAVEHIST=50000
[[ -d ${HISTFILE:h} ]] || mkdir -p ${HISTFILE:h}

source "${XDG_DATA_HOME:-$HOME/.local/share}/znap/zsh-snap/znap.zsh"
zstyle ':znap:*' repos-dir "${XDG_DATA_HOME:-$HOME/.local/share}/znap"

# Needed because only omz libs are sourced, not the framework.
export ZSH_CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/zsh"
[[ -d $ZSH_CACHE_DIR/completions ]] || mkdir -p "$ZSH_CACHE_DIR/completions"

znap source ohmyzsh/ohmyzsh lib/{history,key-bindings,completion,directories,git}
znap source ohmyzsh/ohmyzsh \
{{ if eq .chezmoi.os "darwin" }}	plugins/macos \
{{ end }}	plugins/colored-man-pages \
	plugins/{git,gitfast,git-extras} \
	plugins/npm \
	plugins/{kubectl,terraform,docker}

znap source zsh-users/zsh-completions
znap source aloxaf/fzf-tab
znap source z-shell/F-Sy-H

export YSU_MESSAGE_FORMAT="$(print -P '%F{yellow}')alias tip: %alias$(print -P '%f')"
export YSU_MESSAGE_POSITION="after"
znap source MichaelAquilina/zsh-you-should-use

ZSH_AUTOSUGGEST_STRATEGY=(history)
# Speeds up paste; later widget changes must rebind (zvm_after_init).
ZSH_AUTOSUGGEST_MANUAL_REBIND=1
znap source zsh-users/zsh-autosuggestions

if (( $+commands[fzf] )); then
	source <(fzf --zsh)
fi

znap source romkatv/powerlevel10k

znap eval zoxide 'zoxide init zsh --cmd j'
znap eval mise 'mise activate zsh'
znap eval atuin 'atuin init zsh --disable-up-arrow'

# Up/down stay on substring search, hence --disable-up-arrow.
znap source zsh-users/zsh-history-substring-search
bindkey '^[[A' history-substring-search-up
bindkey '^[[B' history-substring-search-down
bindkey -M vicmd 'k' history-substring-search-up
bindkey -M vicmd 'j' history-substring-search-down

export ZVM_INSERT_MODE_CURSOR=$ZVM_CURSOR_BLINKING_UNDERLINE

# zsh-vi-mode resets keybindings on init, clobbering the binds set above.
function zvm_after_init() {
	bindkey '^R' atuin-search
	bindkey '^[[A' history-substring-search-up
	bindkey '^[[B' history-substring-search-down
	bindkey -M vicmd 'k' history-substring-search-up
	bindkey -M vicmd 'j' history-substring-search-down

	# Needed with MANUAL_REBIND, else suggestions freeze after zvm.
	(( $+functions[_zsh_autosuggest_bind_widgets] )) && _zsh_autosuggest_bind_widgets
}

znap source jeffreytse/zsh-vi-mode

# Don't add bracketed-paste-magic: it makes pasting slow.

for f in "${ZDOTDIR:-$HOME/.config/zsh}"/rc.d/*.zsh(N); do
	source "$f"
done

# Private work config; after rc.d so it can override.
for f in "${ZDOTDIR:-$HOME/.config/zsh}"/work/*.zsh(N); do
	source "$f"
done

# Last, so p10k settings win over the plugins'.
[[ ! -r "${ZDOTDIR:-$HOME/.config/zsh}/prompt/init.zsh" ]] ||
	source "${ZDOTDIR:-$HOME/.config/zsh}/prompt/init.zsh"

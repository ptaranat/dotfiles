# Interactive shell config. Anything non-interactive shells need goes in .zshenv.
# Sets up plugins, prompt and keybindings, then sources rc.d/*.zsh at the end.

# Must stay at the very top: this replays a cached prompt before the rest of the
# file runs, so anything above it that writes to the terminal or reads input
# corrupts the replay.
if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
	source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi

# Which terminal GPG prompts on. Replaces oh-my-zsh's gpg-agent plugin, which
# cost ~730ms of startup to do the same thing.
export GPG_TTY=$TTY

# --- history -----------------------------------------------------------------
# Set here, not .zshenv: macOS's /etc/zshrc hardcodes HISTFILE/HISTSIZE/SAVEHIST
# and is sourced after .zshenv but before this file, so only this file wins.
export HISTFILE="${XDG_STATE_HOME:-$HOME/.local/state}/zsh/history"
export HISTSIZE=50000
export SAVEHIST=50000
[[ -d ${HISTFILE:h} ]] || mkdir -p ${HISTFILE:h}

# --- plugins -----------------------------------------------------------------

source "${XDG_DATA_HOME:-$HOME/.local/share}/znap/zsh-snap/znap.zsh"
zstyle ':znap:*' repos-dir "${XDG_DATA_HOME:-$HOME/.local/share}/znap"

# Some omz plugins cache completions here. The framework normally sets it; we
# only source the libs, so without this they write to /completions and fail.
export ZSH_CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/zsh"
[[ -d $ZSH_CACHE_DIR/completions ]] || mkdir -p "$ZSH_CACHE_DIR/completions"

# oh-my-zsh a la carte: its libs and plugins without the framework or its
# update checker.
znap source ohmyzsh/ohmyzsh lib/{history,key-bindings,completion,directories,git}
znap source ohmyzsh/ohmyzsh \
	plugins/{macos,colored-man-pages} \
	plugins/{git,gitfast,git-extras} \
	plugins/npm \
	plugins/{kubectl,terraform,docker}

znap source zsh-users/zsh-completions
znap source aloxaf/fzf-tab
znap source z-shell/F-Sy-H
ZSH_HIGHLIGHT_HIGHLIGHTERS=(main brackets)

# Trims YSU's three-line nag to a single "alias tip: gst" line.
export YSU_MESSAGE_FORMAT="$(print -P '%F{yellow}')alias tip: %alias$(print -P '%f')"
export YSU_MESSAGE_POSITION="after"
znap source MichaelAquilina/zsh-you-should-use

ZSH_AUTOSUGGEST_STRATEGY=(history)
znap source zsh-users/zsh-autosuggestions

# fzf owns Ctrl-T and Alt-C; fzf-tab owns completion. Ctrl-R is left to atuin.
if (( $+commands[fzf] )); then
	source <(fzf --zsh)
fi

# --- prompt and shell integrations -------------------------------------------
# znap eval caches a command's stdout to disk instead of forking on every
# startup, keyed on the command itself so it refreshes when that changes.

# Kept on p10k rather than starship: it has a compiled gitstatus daemon, the
# instant-prompt cache above, and dirty-worktree background colours. In upstream
# maintenance mode: stable, but no new features or fixes.
znap source romkatv/powerlevel10k

znap eval zoxide 'zoxide init zsh --cmd j'
znap eval mise 'mise activate zsh'
znap eval atuin 'atuin init zsh --disable-up-arrow'

# atuin takes Ctrl-R; up/down stay on prefix-aware search, hence --disable-up-arrow.
znap source zsh-users/zsh-history-substring-search
bindkey '^[[A' history-substring-search-up
bindkey '^[[B' history-substring-search-down
bindkey -M vicmd 'k' history-substring-search-up
bindkey -M vicmd 'j' history-substring-search-down

export ZVM_INSERT_MODE_CURSOR=$ZVM_CURSOR_BLINKING_UNDERLINE
znap source jeffreytse/zsh-vi-mode

# --- paste performance -------------------------------------------------------
# Without this, autosuggestions recompute per character and pasting is slow.
pasteinit() {
	OLD_SELF_INSERT=${${(s.:.)widgets[self-insert]}[2,3]}
	zle -N self-insert url-quote-magic
}
pastefinish() {
	zle -N self-insert $OLD_SELF_INSERT
}
zstyle :bracketed-paste-magic paste-init pasteinit
zstyle :bracketed-paste-magic paste-finish pastefinish

# --- local config ------------------------------------------------------------
# (N) so an empty or missing directory is not an error.
for f in "${ZDOTDIR:-$HOME/.config/zsh}"/rc.d/*.zsh(N); do
	source "$f"
done

# Work config from a separate private repo, sourced after rc.d so it can override.
for f in "${ZDOTDIR:-$HOME/.config/zsh}"/work/*.zsh(N); do
	source "$f"
done

# Last, so p10k's settings win over anything the plugins set.
[[ ! -r "${ZDOTDIR:-$HOME/.config/zsh}/prompt/init.zsh" ]] ||
	source "${ZDOTDIR:-$HOME/.config/zsh}/prompt/init.zsh"

# opencode
path=($HOME/.opencode/bin(N-/) $path)

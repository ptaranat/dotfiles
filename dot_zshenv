# The only zsh file in $HOME; it points zsh at $XDG_CONFIG_HOME/zsh for the rest.
# Sourced for every zsh invocation, so keep it to environment setup only:
# no output, no prompts, nothing slow.

export XDG_CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
export XDG_CACHE_HOME="${XDG_CACHE_HOME:-$HOME/.cache}"
export XDG_DATA_HOME="${XDG_DATA_HOME:-$HOME/.local/share}"
export XDG_STATE_HOME="${XDG_STATE_HOME:-$HOME/.local/state}"

export ZDOTDIR="$XDG_CONFIG_HOME/zsh"

# History lives in .zshrc: macOS ships an /etc/zshrc that hardcodes HISTFILE,
# HISTSIZE and SAVEHIST and is sourced after this file, clobbering anything set here.

# Set here, not .zshrc, so these resolve in non-interactive shells too.
path=($HOME/.local/bin(N-/) $path)

# Homebrew and $HOME/bin. Here rather than rc.d/01-environment.zsh because
# .zshrc's `znap eval atuin` runs before rc.d is sourced. Order matches the old
# rc.d file so final PATH priority is unchanged.
path=(/opt/homebrew/bin(N-/) $path)
path=(/opt/homebrew/sbin(N-/) $path)
path=($HOME/bin(N-/) $path)

# OrbStack and JetBrains Toolbox. Both installers appended to ~/.zprofile, which
# stopped being read once ZDOTDIR was set, since zsh takes .zprofile from there.
# Appended, not prepended, to match what the installers set up.
path=($path $HOME/.orbstack/bin(N-/))
path=($path "$HOME/Library/Application Support/JetBrains/Toolbox/scripts"(N-/))

# OrbStack's completions. Its init.zsh sets only this and the PATH line above.
fpath+=($HOME/.orbstack/shell/completions/zsh(N-/))
